{
  "name": "fnstools-website",
  "version": "1.0.0",
  "private": true,
  "description": "functionstore.tools — landing page and generated docs for FNSTools",
  "type": "module",
  "scripts": {
    "build": "node tools/build-site.mjs && npm run search",
    "pages": "node tools/build-site.mjs",
    "search": "node -e \"require('fs').rmSync('docs/pagefind',{recursive:true,force:true})\" && pagefind --site docs --output-subdir pagefind",
    "serve": "npx --yes serve .",
    "cms": "node tools/cms.mjs",
    "test:chat": "node tools/test-chat.mjs",
    "test:discord": "node tools/test-discord.mjs",
    "test:limit": "node tools/test-limit.mjs"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "pagefind": "^1.1.1"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "ai": "^7.0.146",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  }
}
